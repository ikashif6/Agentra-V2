# Store branding (neutral defaults — set per merchant)
STORE_NAME=Store
AGENT_NAME=Store Assistant
WIDGET_COLOR=#d85a30
# STORE_WELCOME_MESSAGE=Hi! How can we help today?
# STORE_CONTACT_EMAIL=
# STORE_CONTACT_PHONE=

# Public storefront host for product links (not *.myshopify.com)
STORE_PUBLIC_DOMAIN=

# Optional: tone/style only. Never used for security, facts, or permissions.
# STORE_OWNER_INSTRUCTIONS=Keep replies warm and concise. Prefer “we” over “I”.
# CHANNEL_INSTRUCTIONS_JSON=[{"channel":"web","text":"Keep web chat short."}]

# Optional feature overrides (all on by default except initiate_refund).
# CHATBOT_FEATURES_JSON={"discounts":false,"handoff":true}

# Optional merchant coupon list (JSON). If unset: demo codes only for COMMERCE_PROVIDER=custom;
# Shopify/Woo leave empty so the bot never invents promos.
# KNOWN_COUPONS_JSON=[{"code":"SAVE10","description":"10% off"}]

# Business hours (24h local, comma-separated days 0=Sun..6=Sat)
BUSINESS_HOURS_TZ=America/New_York
BUSINESS_HOURS_DAYS=1,2,3,4,5
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
AGENTS_AVAILABLE=true
