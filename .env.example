# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/agentraa_dev

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@agentraa.com
RESEND_FROM_NAME=Agentra

# Paddle Billing (Agentra Pro subscriptions) — see docs/PADDLE_SETUP.md
# Sandbox first: PADDLE_ENV=sandbox, sandbox tokens + pri_* price IDs.
# Webhook URL: https://api.agentraa.com/api/v1/webhooks/paddle
# Events: subscription.created, subscription.updated, subscription.canceled,
#         subscription.past_due, transaction.completed, transaction.payment_failed
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=

# Email channel (Settings → Channels → Email): customers connect their own mailbox
# Used to encrypt stored IMAP/SMTP passwords + OAuth tokens (falls back to JWT_SECRET)
CREDENTIALS_ENCRYPTION_KEY=change_me_to_a_long_random_string
# How often to poll connected IMAP mailboxes for new mail (ms)
EMAIL_POLL_INTERVAL_MS=60000
# Google OAuth (staff Sign in + Connect Gmail) — see ops/oauth-verification-checklist.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Redirect URIs to register in Google Cloud (Web client):
#   https://api.agentraa.com/api/v1/auth/google/callback
#   https://api.agentraa.com/api/v1/channels/email/google/callback
#   http://localhost:5000/api/v1/auth/google/callback
#   http://localhost:5000/api/v1/channels/email/google/callback
#
# Microsoft Entra OAuth (Sign in with Microsoft + Connect Outlook)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=common
# Redirect URIs to register in Entra (Web):
#   https://api.agentraa.com/api/v1/auth/microsoft/callback
#   https://api.agentraa.com/api/v1/channels/email/microsoft/callback
#   http://localhost:5000/api/v1/auth/microsoft/callback
#   http://localhost:5000/api/v1/channels/email/microsoft/callback

# App
APP_BASE_DOMAIN=agentraa.com
APP_FRONTEND_URL=https://app.agentraa.com
APP_FRONTEND_DEV_PORT=3000
# Email links in development use http://localhost:3000 (verify) so links work without DNS
# Production verify links use https://<subdomain>.agentraa.com
# EMAIL_VERIFY_URL_TEMPLATE=http://localhost:3000/auth/verify-email?token={token}
# EMAIL_LOGO_URL=https://app.agentraa.com/agentraa-logo.svg

# Magic Link / OTP
MAGIC_LINK_EXPIRES_MINUTES=15
OTP_EXPIRES_MINUTES=10

# Rate Limiting (global defaults are higher in development — see src/app.js)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=100

# Set true when pointing at the same MongoDB as production (avoids duplicate email/store polling)
DISABLE_BACKGROUND_JOBS=false

# Ticket Tracking (OTP for unauthenticated customers)
TRACK_OTP_EXPIRES_MINUTES=10
JWT_TRACK_SECRET=your_super_secret_track_key_change_this_in_production
TRACK_TOKEN_EXPIRES_IN=30m

# File Uploads
APP_API_URL=http://localhost:5000
MAX_UPLOAD_SIZE_MB=10

# Meta / Facebook Messenger (Settings → Channels → Facebook)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=your_random_webhook_verify_token
# OAuth redirect (add this exact URL in Meta app → Facebook Login → Valid OAuth Redirect URIs):
# http://localhost:5000/api/v1/channels/facebook/oauth/callback
# Webhook URL (Meta app → Messenger → Webhooks):
# http://localhost:5000/api/v1/webhooks/facebook
# WhatsApp Embedded Signup configuration id (required to show Connect WhatsApp).
# Meta app → WhatsApp → Configuration → Embedded Signup → Configurations → copy Configuration ID:
META_WA_CONFIG_ID=

# Store integration (Settings → Store) — not App Store listed.
# Merchants connect Shopify from Agentra Settings (standard OAuth). No Shopify Billing needed.
# Paste API key/secret from Partner Dashboard / Dev Dashboard.
# App URL:
#   https://api.agentraa.com/api/v1/store/shopify/app
# Allowed redirection URL(s):
#   https://api.agentraa.com/api/v1/store/shopify/oauth/callback
# Mandatory compliance webhooks (GDPR):
#   https://api.agentraa.com/api/v1/webhooks/shopify/customers-data-request
#   https://api.agentraa.com/api/v1/webhooks/shopify/customers-redact
#   https://api.agentraa.com/api/v1/webhooks/shopify/shop-redact
# Optional uninstall webhook:
#   https://api.agentraa.com/api/v1/webhooks/shopify/app-uninstalled
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional: customers/data_request summary inbox (defaults to RESEND_FROM_EMAIL)
# SHOPIFY_COMPLIANCE_EMAIL=hello@agentraa.com
# write_* scopes let agents refund / edit / fulfill orders from the inbox (like Gorgias).
# write_script_tags enables one-click live chat widget install on Shopify storefronts.
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,write_customers,read_products,read_fulfillments,write_fulfillments,write_script_tags
# Optional one-off Partner "custom distribution" install link (per store, expires ~7 days).
# Not needed for Settings → Connect Shopify OAuth. Leave unset for normal multi-tenant use.
# SHOPIFY_CUSTOM_INSTALL_LINK=
# How often to re-sync connected stores as a fallback for missed webhooks (ms)
STORE_SYNC_INTERVAL_MS=900000

# TikTok (Settings → Channels → TikTok)
# Use Sandbox client key/secret while testing; switch to Production keys after app approval.
TIKTOK_CLIENT_KEY=your_sandbox_client_key
TIKTOK_CLIENT_SECRET=your_sandbox_client_secret
# Login Kit redirect (TikTok Developer Portal → Sandbox → Login Kit → Web):
#   https://api.agentraa.com/api/v1/channels/tiktok/oauth/callback
# Webhooks callback URL (Sandbox → Webhooks):
#   https://api.agentraa.com/api/v1/webhooks/tiktok
# Sandbox target user must be added under Sandbox settings → Add account.

# Live chat AI (Groq — Settings → Channels → Live chat)
HELPDESK_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_UNDERSTANDING_MODEL=llama-3.3-70b-versatile
GROQ_RESPONSE_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARY_MODEL=llama-3.1-8b-instant

# Used when HELPDESK_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_REPAIR_ATTEMPTS=1
AI_MAX_CLARIFICATION_ATTEMPTS=3
AI_WORKFLOW_EXPIRY_MINUTES=120
AI_CONFIRMATION_EXPIRY_MINUTES=15
AI_HANDOFF_AFTER_FAILURES=3
AI_SUMMARY_MESSAGE_THRESHOLD=24
AI_SUMMARY_KEEP_RECENT=8
# Conversation pipeline: v2 | v3 | shadow | v1 | chatbot
# chatbot = standalone Chatbot AI Agent (recommended for ecommerce)
AI_CONVERSATION_PIPELINE=v2
CHATBOT_ENGINE_ENABLED=false
CHATBOT_ENGINE_URL=http://localhost:5600
CHATBOT_BRIDGE_SECRET=
# Immediate rollback for all workspaces (forces v2)
AI_ASSISTANT_V3_KILL_SWITCH=
# Set to 1 in tests to skip response-phrasing LLM and use planner suggestedText
AI_SKIP_RESPONSE_LLM=
# Dev only: if orchestrator cannot handle a turn, return a visible error instead of legacy Groq
AI_DISABLE_LEGACY_CHAT_FALLBACK=true
# Optional short-lived runtime config cache (ms); keyed by workspace+channel+assistantConfigVersion
ASSISTANT_RUNTIME_CONFIG_CACHE_MS=5000
# Help Center
# Domain used to auto-detect help subdomains: help.<subdomain>.<APP_BASE_DOMAIN>
# CORS for verified custom help domains is refreshed every 5 minutes from DB
HELP_CENTER_DOMAIN_VERIFICATION_ENABLED=false   # set true in production to do real DNS TXT lookup
